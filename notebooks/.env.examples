# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real credentials.
# All keys are loaded at runtime via os.getenv() + python-dotenv.

# NOAA NCEI Climate Data Online (GHCND daily summaries)
# Request at: https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=

# U.S. Census Bureau Data API (for CDC/ATSDR SVI county joins)
# Request at: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# USDA NASS Quick Stats API (commodity / production volumes)
# Request at: https://quickstats.nass.usda.gov/api
NASS_API_KEY=

# USDA AMS Market News API (commodity transit / movement)
# Portal: https://mymarketnews.ams.usda.gov
AMS_API_KEY=
